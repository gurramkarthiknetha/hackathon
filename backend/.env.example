# FastAPI Backend Environment Variables

# Server Configuration
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration
MONGODB_URI=mongodb+srv://hackergkn:karthik@hackathon.xkjyqhh.mongodb.net/aievent?retryWrites=true&w=majority&appName=hackathon
DB_NAME=aievent

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure

# Client URL (for password reset links)
CLIENT_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=AI Event Monitor

# Alternative SMTP providers (uncomment to use)
# For Outlook/Hotmail
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587

# For custom SMTP
# EMAIL_HOST=your_smtp_host
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Rate Limiting Configuration (optional - defaults are set in config.py)
# RATE_LIMIT_WINDOW=900
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=5
# PASSWORD_RESET_RATE_LIMIT_MAX=3
# EMAIL_VERIFICATION_RATE_LIMIT_MAX=15

# Security Configuration (optional)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=strict
